{
  "resources": [
    {
      "name": "flightplan.git",
      "type": "git",
      "source": {
        "uri": "https://github.com/marco-m/flightplan.git"
      }
    },
    {
      "name": "artifacts.s3",
      "type": "s3",
      "source": {
        "bucket": "concourse",
        "regexp": "builds/simple-s3/gift-(.*)",
        "endpoint": "((s3-endpoint))",
        "region_name": "((s3-region))",
        "access_key_id": "((s3-access-key))",
        "secret_access_key": "((s3-secret-key))",
        "use_path_style": true
      }
    }
  ],
  "jobs": [
    {
      "name": "knead-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "trigger": true
        },
        {
          "task": "prepare-dough",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "outputs": [
              {
                "name": "gift"
              }
            ],
            "run": {
              "path": "sh",
              "args": [
                "-c",
                "\nset -ex\nVERSION=$(date +%Y%m%d%H%M%S)\nGIFT=gift/gift-$VERSION\necho \"hello\" \u003e $GIFT\n"
              ]
            }
          }
        },
        {
          "put": "artifacts.s3",
          "params": {
            "file": "gift/gift-*"
          }
        }
      ]
    },
    {
      "name": "bake-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "passed": [
            "knead-pizza"
          ],
          "trigger": true
        },
        {
          "get": "artifacts.s3",
          "passed": [
            "knead-pizza"
          ]
        },
        {
          "task": "insert-in-hoven",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "env"
            }
          }
        }
      ]
    }
  ]
}
