{
  "resources": [
    {
      "name": "flightplan.git",
      "type": "git",
      "source": {
        "uri": "https://github.com/marco-m/flightplan.git"
      }
    },
    {
      "name": "artifacts.s3",
      "type": "s3",
      "source": {
        "bucket": "concourse",
        "regexp": "builds/simple-s3/gift-(.*)"
      }
    }
  ],
  "jobs": [
    {
      "name": "knead-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "trigger": true
        },
        {
          "task": "prepare-dough",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "env"
            }
          }
        },
        {
          "put": "artifacts.s3"
        }
      ]
    },
    {
      "name": "bake-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "passed": [
            "knead-pizza"
          ],
          "trigger": true
        },
        {
          "get": "artifacts.s3",
          "passed": [
            "knead-pizza"
          ]
        },
        {
          "task": "put-in-hoven",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "env"
            }
          }
        }
      ]
    }
  ]
}
