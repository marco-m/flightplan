#
# Integration tests against Concourse
#
[!concourse] skip
env FLY_HOME=.

# login
fly -t dev login -c http://localhost:8080 --username=main --password=main --team-name=main
stdout 'logging in to team'
stdout 'target saved'

# set-pipeline
fly -t dev set-pipeline --non-interactive -p simple -c $TESTDATA/script/examples/simple.want.json

# unpause-pipeline
fly -t dev unpause-pipeline -p simple

# trigger-job, will take ages
sleep 100ms
fly -t dev trigger-job -j simple/knead-pizza --watch
stdout 'succeeded'
