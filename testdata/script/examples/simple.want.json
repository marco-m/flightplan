{
  "resources": [
    {
      "name": "flightplan.git",
      "type": "git",
      "source": {
        "uri": "https://github.com/marco-m/flightplan.git",
        "branch": "master"
      }
    }
  ],
  "jobs": [
    {
      "name": "knead-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "trigger": true
        },
        {
          "task": "prepare-dough",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "ciccio"
              ]
            }
          }
        },
        {
          "task": "let-dough-rise",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "bello"
              ]
            }
          }
        }
      ]
    }
  ]
}
