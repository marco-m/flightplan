#
# Command-line help.
#
exec examples-empty -h
! stdout .
cmp stderr output.want

#
# Empty pipeline returns an error.
#
! exec examples-empty
! stdout .
stderr 'render: pipeline cannot be empty'



-- output.want --
examples-empty -- generate a Concourse pipeline with flightplan

Usage: examples-empty [ARGS]

Options:
  -name string
    	Name of the pipeline file (default "empty")
