#
# Report error if cannot create directory
#
! exec examples-simple -directory /mango
! stdout .
stderr 'error: mkdir /mango:'

#
# Generate pipeline, default values
#
exec examples-simple
! stdout .
stderr 'wrote pipeline to /.+/simple.json'
cmp simple.json simple.want.json

#
# Generate pipeline, override name and directory, relative path
#
exec examples-simple -name banana -directory mango
! stdout .
stderr 'wrote pipeline to /.+/mango/banana.json'
cmp mango/banana.json simple.want.json

#
# Generate pipeline, override name and directory, absolute path
#
exec examples-simple -name banana -directory $WORK/mango
! stdout .
stderr 'wrote pipeline to /.+/mango/banana.json'
cmp $WORK/mango/banana.json simple.want.json

-- simple.want.json --
{
  "resources": [
    {
      "name": "flightplan.git",
      "type": "git",
      "source": {
        "uri": "https://github.com/marco-m/flightplan.git",
        "branch": "master",
        "paths": [
          "ci/*"
        ]
      }
    }
  ],
  "jobs": [
    {
      "name": "knead-pizza",
      "plan": [
        {
          "get": "flightplan.git",
          "trigger": true
        },
        {
          "task": "prepare-dough",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "golang"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "ciccio"
              ]
            }
          }
        },
        {
          "task": "let-dough-rise",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "golang"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "bello"
              ]
            }
          }
        }
      ]
    }
  ]
}
