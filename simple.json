{
  "jobs": [
    {
      "name": "knead-pizza",
      "plan": [
        {
          "task": "prepare-dough",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "ciccio"
              ]
            }
          }
        },
        {
          "task": "let-dough-rise",
          "config": {
            "platform": "linux",
            "image_resource": {
              "type": "registry-image",
              "source": {
                "repository": "alpine"
              }
            },
            "run": {
              "path": "echo",
              "args": [
                "bello"
              ]
            }
          }
        }
      ]
    }
  ]
}
