#
# Command-line help.
#
exec empty -h
! stdout .
cmp stderr output.want

#
# Command-line unrecognized argument.
#
! exec empty ciao bello
! stdout .
stderr 'unrecognized arguments: ciao bello'

-- output.want --
empty -- generate a Concourse pipeline with flightplan

Usage: empty [ARGS]

Options:
  -directory string
    	Directory in which to write the pipeline file (default ".")
  -name string
    	Name of the pipeline file (default "empty")
